# ---------------------------------------------------------------------------
# Copiar a .env y completar. El .env real NUNCA se sube al repositorio (S-06).
# ---------------------------------------------------------------------------

# --- Aplicación -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Orígenes permitidos por CORS, separados por coma (S-13: solo el dominio del frontend)
CORS_ORIGINS=http://localhost:5173

# --- Dependencias locales (docker-compose.dev.yml) --------------------------
# Credenciales largas y aleatorias (S-02). Ej.: openssl rand -hex 24
POSTGRES_USER=analizador
POSTGRES_PASSWORD=
POSTGRES_DB=analizador
RABBITMQ_USER=analizador
RABBITMQ_PASSWORD=

# --- PostgreSQL (C-05) -------------------------------------------------------
# Driver asyncpg para SQLAlchemy. El checkpointer de LangGraph (P-08) deriva de aquí su URL psycopg.
DATABASE_URL=postgresql+asyncpg://analizador:CAMBIAR@localhost:5432/analizador

# --- RabbitMQ (C-04) ---------------------------------------------------------
RABBITMQ_URL=amqp://analizador:CAMBIAR@localhost:5672/

# --- Supabase: Auth (C-08) y Storage (C-07) ----------------------------------
# https://<proyecto>.supabase.co  (JWKS en /auth/v1/.well-known/jwks.json)
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Solo backend (S-06). Necesaria para invitar usuarios (F-01) y para guardar y leer los PDF.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVADO de Supabase Storage donde se guardan los pliegos (sustituye a S3, ADR-005).
SUPABASE_STORAGE_BUCKET=
# Vigencia en segundos de las URL firmadas del PDF (P-14, S-10: "pocos minutos")
STORAGE_URL_TTL_SECONDS=300

# --- Límites (S-08) ----------------------------------------------------------
# Tamaño máximo del PDF en MB. Valor por decidir por el equipo.
MAX_PDF_MB=
# Valores provisionales: P-23 no fija cifras. Ajustar según el presupuesto (RC-02) y Q-13.
# Número máximo de páginas del pliego (se comprueba al leer el PDF en el worker)
MAX_PDF_PAGINAS=600
# Tamaño máximo en MB del archivo JSON de la base de conocimiento
MAX_CONOCIMIENTO_MB=5
# Cuotas por organización en 24 horas: análisis nuevos y preguntas al chat
CUOTA_ANALISIS_DIARIA=20
CUOTA_CHAT_DIARIA=200
# Longitud máxima de una pregunta al chat, en caracteres
CHAT_MAX_CARACTERES=2000

# --- Anthropic (C-10) — modelos configurables por entorno (P-19) ------------
ANTHROPIC_API_KEY=
# Candidatos en P-10 (sin decidir). Si quedan vacíos, la etapa que los use falla con un error claro.
ANTHROPIC_MODEL_EXTRACCION=
ANTHROPIC_MODEL_VERIFICACION=
ANTHROPIC_MODEL_REDACCION=
# Modelo con visión para transcribir páginas escaneadas que Tesseract no logra leer (P-09).
# Si queda vacío, esas páginas se marcan como no leídas.
ANTHROPIC_MODEL_OCR=

# --- NVIDIA (C-09) — modelos configurables por entorno (P-19) ---------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FILTRO=
NVIDIA_MODEL_EMBEDDINGS=
NVIDIA_MODEL_CHAT=
# Reranker (P-11, sin decidir)
NVIDIA_MODEL_RERANK=
# Límite de peticiones por minuto y reintentos con espera ante errores 429 (R-02, Q-13)
# Textos por llamada al modelo de embeddings
EMBEDDINGS_LOTE=32
NVIDIA_PETICIONES_POR_MINUTO=30
NVIDIA_MAX_REINTENTOS=5
NVIDIA_ESPERA_BASE_SEGUNDOS=2
NVIDIA_ESPERA_MAXIMA_SEGUNDOS=60

# --- Pipeline ----------------------------------------------------------------
# --- Lectura y OCR (HU-B10) --------------------------------------------------
# Idioma de Tesseract (requiere el paquete de idioma instalado; la imagen Docker trae "spa")
OCR_IDIOMA=spa
OCR_DPI=200
# Una página con menos caracteres extraíbles que estos se trata como escaneada
OCR_MIN_CARACTERES=20
# Confianza media mínima (0-100) para dar por legible el texto de Tesseract
OCR_CONFIANZA_MINIMA=50
# Máximo de páginas por pliego que se envían al modelo con visión
OCR_VISION_MAX_PAGINAS=30
# Tamaño máximo de una sección, en caracteres; las más largas se parten en tramos
SECCION_MAX_CARACTERES=12000
# Filtro de secciones (NVIDIA): secciones por llamada y caracteres máximos por lote
FILTRO_LOTE=8
FILTRO_MAX_CARACTERES_LOTE=24000
# Secciones que se envían a Claude a la vez en la extracción de requisitos
EXTRACCION_CONCURRENCIA=3
# Reintentos de las secciones que quedaron en error o pendientes tras la extracción
COBERTURA_MAX_REINTENTOS=2

# P-08: persistir el estado de LangGraph en PostgreSQL para reanudar trabajos fallidos
PIPELINE_CHECKPOINTER_ENABLED=true
# Tiempo máximo de un trabajo, en segundos, antes de darlo por fallido (S-09)
PIPELINE_TIMEOUT_SEGUNDOS=3600
# Entregas del mismo mensaje que se toleran antes de abandonar el trabajo (HU-B09)
PIPELINE_MAX_INTENTOS=3
