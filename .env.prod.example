# ---------------------------------------------------------------------------
# Producción (EC2). En la instancia: cp .env.prod.example .env  y completar.
# El .env real NUNCA se sube al repositorio (S-06). Permisos: chmod 600 .env
# Generar contraseñas con: openssl rand -hex 24   (hex: sin caracteres que rompan las URLs)
# ---------------------------------------------------------------------------

# --- Aplicación -------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
# Orígenes permitidos por CORS, separados por coma (S-13: solo el dominio del frontend)
CORS_ORIGINS=https://app.ejemplo.com

# --- Proxy (Caddy) -----------------------------------------------------------
# Dominio de la API (registro DNS A → IP elástica de la instancia) para HTTPS automático.
# Sin dominio, usar ":80" (solo HTTP por IP; no recomendado fuera de pruebas).
API_DOMAIN=api.ejemplo.com
# Tamaño máximo de cuerpo aceptado por el proxy (margen sobre MAX_PDF_MB)
PROXY_MAX_BODY=50MB

# --- Imagen del backend (GHCR) -----------------------------------------------
# El CD exporta ambas en cada despliegue (tag = SHA del commit); estos valores solo se usan
# al operar a mano en la instancia. Nombre en minúsculas.
BACKEND_IMAGE=ghcr.io/telettubies/telettubiesplus-backend
BACKEND_TAG=latest

# --- PostgreSQL (C-05) -------------------------------------------------------
# DATABASE_URL se arma en docker-compose.prod.yml con estos valores.
POSTGRES_USER=analizador
POSTGRES_PASSWORD=
POSTGRES_DB=analizador

# --- RabbitMQ (C-04) ---------------------------------------------------------
# RABBITMQ_URL se arma en docker-compose.prod.yml con estos valores.
RABBITMQ_USER=analizador
RABBITMQ_PASSWORD=

# --- Supabase: Auth (C-08) y Storage (C-07) ----------------------------------
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Solo backend (S-06): invita usuarios y accede al bucket. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVADO donde se guardan los pliegos (sustituye a S3, ADR-005).
SUPABASE_STORAGE_BUCKET=
STORAGE_URL_TTL_SECONDS=300

# --- Límites (S-08) ----------------------------------------------------------
MAX_PDF_MB=25
# Valores provisionales: P-23 no fija cifras. Ajustar según el presupuesto (RC-02) y Q-13.
# Número máximo de páginas del pliego (se comprueba al leer el PDF en el worker)
MAX_PDF_PAGINAS=600
# Tamaño máximo en MB del archivo JSON de la base de conocimiento
MAX_CONOCIMIENTO_MB=5
# Cuotas por organización en 24 horas: análisis nuevos y preguntas al chat
CUOTA_ANALISIS_DIARIA=20
CUOTA_CHAT_DIARIA=200
# Longitud máxima de una pregunta al chat, en caracteres
CHAT_MAX_CARACTERES=2000

# --- Anthropic (C-10) --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACCION=
ANTHROPIC_MODEL_VERIFICACION=
ANTHROPIC_MODEL_REDACCION=

# --- NVIDIA (C-09) -----------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FILTRO=
NVIDIA_MODEL_EMBEDDINGS=
NVIDIA_MODEL_CHAT=
NVIDIA_MODEL_RERANK=
# Límite de peticiones por minuto y reintentos con espera ante errores 429 (R-02, Q-13)
# Textos por llamada al modelo de embeddings
EMBEDDINGS_LOTE=32
NVIDIA_PETICIONES_POR_MINUTO=30
NVIDIA_MAX_REINTENTOS=5
NVIDIA_ESPERA_BASE_SEGUNDOS=2
NVIDIA_ESPERA_MAXIMA_SEGUNDOS=60

# --- Pipeline ----------------------------------------------------------------
PIPELINE_CHECKPOINTER_ENABLED=true
# Tiempo máximo de un trabajo, en segundos, antes de darlo por fallido (S-09)
PIPELINE_TIMEOUT_SEGUNDOS=3600
# Entregas del mismo mensaje que se toleran antes de abandonar el trabajo (HU-B09)
PIPELINE_MAX_INTENTOS=3
